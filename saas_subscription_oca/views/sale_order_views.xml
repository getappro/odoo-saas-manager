<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_order_form_inherit_saas" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.saas</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='client_order_ref']" position="after">
                    <field name="saas_subdomain" placeholder="ex: mon-client"/>
                    <field name="saas_country_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

