<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_saas_plan_form_inherit_subscription_oca" model="ir.ui.view">
            <field name="name">saas.plan.form.subscription.oca</field>
            <field name="model">saas.plan</field>
            <field name="inherit_id" ref="saas_manager.view_saas_plan_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[field[@name='code']]" position="inside">
                    <field name="subscription_template_id" options="{'no_create': False}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
