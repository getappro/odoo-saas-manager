<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_saas" model="ir.ui.view">
        <field name="name">product.template.form.inherit.saas</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='subscribable']" position="after">
                <group string="SaaS" invisible="not subscribable">
                    <field name="saas_template_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

