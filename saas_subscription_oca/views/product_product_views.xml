<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit.saas.subscription</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="after">
                <group string="Subscription" invisible="not subscribable">
                    <field name="subscription_template_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
