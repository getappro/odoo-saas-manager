<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_saas_instance_form_inherit_subscription_oca" model="ir.ui.view">
            <field name="name">saas.instance.form.subscription.oca</field>
            <field name="model">saas.instance</field>
            <field name="inherit_id" ref="saas_manager.view_saas_instance_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='template_id']" position="after">
                    <field name="sale_subscription_id" options="{'no_create': True}"/>
                </xpath>
                <xpath expr="//field[@name='version']" position="after">
                    <field name="saas_country_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <record id="view_saas_instance_list_inherit_subscription_oca" model="ir.ui.view">
            <field name="name">saas.instance.list.subscription.oca</field>
            <field name="model">saas.instance</field>
            <field name="inherit_id" ref="saas_manager.view_saas_instance_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='template_id']" position="after">
                    <field name="sale_subscription_id"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="before">
                    <field name="saas_country_id" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

