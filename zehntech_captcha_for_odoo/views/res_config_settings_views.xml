<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_website_captcha_res_config" model="ir.ui.view">
      <field name="name">res.config.settings.website.captcha</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="website.res_config_settings_view_form"/>
      <field name="arch" type="xml">

        <xpath expr="//block[@id='website_info_settings']" position="after">
          <block title="Captcha" name="captcha_settings_block">

            <group>
              <field name="website_id"/>
              <field name="captcha_enabled"/>
              <field name="captcha_not_verified_message"/>
            </group>

            <group>
              <group string="Apply To Forms">
                <field name="captcha_on_login"/>
                <field name="captcha_on_signup"/>
                <field name="captcha_on_reset"/>
              </group>
              <group string="Captcha Type">
                <field name="captcha_type"/>
                <!-- <button type="object" name="action_configure_captcha" string="Configure Captcha" class="btn btn-primary mt-2" icon="fa-cogs"/> -->
              </group>
            </group>

            <group modifiers="{'invisible': [('captcha_type', '!=', 'math')]}">
              <group string="Mathematical Captcha Settings">
                <field name="math_operation"/>
                <field name="math_rhs_len"/>
              </group>
            </group>

            <group modifiers="{'invisible': [('captcha_type', '!=', 'num')]}">
              <group string="Numbers Image Settings">
                <field name="num_include_symbols"/>
                <field name="num_length"/>
              </group>
            </group>

            <group modifiers="{'invisible': [('captcha_type', '!=', 'alpha')]}">
              <group string="Alphabetic Image Settings">
                <field name="alpha_include_caps"/>
                <field name="alpha_include_symbols"/>
                <field name="alpha_length"/>
              </group>
            </group>

            <separator string="Preview"/>
            <div class="oe_inline">
              <button type="object" name="action_refresh_preview"
                      string="Refresh Preview" class="btn btn-secondary"/>
            </div>

            <group modifiers="{'invisible': [('captcha_type','!=','math')]}">
              <field name="captcha_preview_text" readonly="1" string="Preview Text"/>
            </group>

            <group modifiers="{'invisible': [('captcha_type','=','math')]}">
              <field name="captcha_preview_text" readonly="1" string="Preview Text (matches image below)"/>
              <field name="captcha_preview_image" widget="image" readonly="1" string="Preview Image"/>
            </group>

          </block>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
