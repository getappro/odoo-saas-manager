<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Captcha Configuration Wizard Form View -->
        <record id="captcha_config_wizard_form" model="ir.ui.view">
            <field name="name">captcha.config.wizard.form</field>
            <field name="model">captcha.config.wizard</field>
            <field name="arch" type="xml">
                <form string="Configure Captcha">
                    <sheet>
                        <div class="oe_title">
                            <h1>Configure Captcha Settings</h1>
                        </div>

                        <group>
                            <group>
                                <field name="captcha_type" widget="radio" required="1"/>
                            </group>
                        </group>

                        <!-- Mathematical Captcha Configuration -->
                        <group string="Mathematical Captcha Settings" modifiers="{'invisible': [('captcha_type', '!=', 'math')]}">
                            <group>
                                <field name="math_operation"/>
                                <field name="math_rhs_len"/>
                            </group>
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <strong>Mathematical Captcha:</strong> Users will be asked to solve simple math problems like "5 + 3 = ?"
                                </div>
                            </group>
                        </group>

                        <!-- Numbers Image Configuration -->
                        <group string="Numbers Image Settings" modifiers="{'invisible': [('captcha_type', '!=', 'num')]}">
                            <group>
                                <field name="num_length"/>
                                <field name="num_include_symbols"/>
                            </group>
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <strong>Numbers Image Captcha:</strong> Users will see an image with numbers and must type what they see.
                                </div>
                            </group>
                        </group>

                        <!-- Alphabetic Image Configuration -->
                        <group string="Alphabetic Image Settings" modifiers="{'invisible': [('captcha_type', '!=', 'alpha')]}">
                            <group>
                                <field name="alpha_length"/>
                                <field name="alpha_include_caps"/>
                                <field name="alpha_include_symbols"/>
                            </group>
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <strong>Alphabetic Image Captcha:</strong> Users will see an image with letters and must type what they see.
                                </div>
                            </group>
                        </group>
                    </sheet>

                    <footer>
                        <button string="Save Configuration" type="object" name="action_save_config" class="btn btn-primary"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for the wizard -->
        <record id="action_captcha_config_wizard" model="ir.actions.act_window">
            <field name="name">Configure Captcha</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">captcha.config.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>