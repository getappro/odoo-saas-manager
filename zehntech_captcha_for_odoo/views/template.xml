<?xml version="1.0" encoding="utf-8"?>
<odoo> 
    <!-- Captcha Options for Website Forms -->
    <template id="website_form_captcha_options" inherit_id="website.snippet_options">
        <xpath expr="//div[contains(@data-js, 'Field')]" position="after">
            <div data-js="WebsiteFormCaptcha"
                data-selector=".s_website_form"
                data-no-check="true">

                <!-- Captcha Section Header -->
                <!-- <we-row string="Captcha Protection">
                    <we-button class="o_we_no_toggle o_we_bg_info text-white"
                        style="pointer-events: none; opacity: 0.8;">
                        <i class="fa fa-shield"></i>
                        <span>Form Security</span>
                    </we-button>
                </we-row> -->

                <!-- Enable Captcha Button - ONLY adds field, no dialog -->
                <we-row string="Add Captcha">
                    <we-button data-enable-captcha="true"
                        data-attribute-name="data-enable-captcha"
                        class="o_we_no_toggle o_we_bg_success"
                        data-no-preview="true"
                        title="Add captcha verification to this form"
                        data-method="enableCaptcha">
                        <!-- <i class="fa fa-plus"></i> -->
                        <!-- <span>Enable Captcha</span> -->
                        Enable Captcha
                    </we-button>
                </we-row>

                <!-- Remove Captcha Button -->
                <we-row string="Remove Captcha">
                    <we-button data-remove-captcha="true"
                        data-attribute-name="data-remove-captcha"
                        class="o_we_no_toggle o_we_bg_danger"
                        data-no-preview="true"
                        title="Remove captcha from this form"
                        data-method="removeCaptcha">
                        <!-- <i class="fa fa-trash"></i> -->
                        <!-- <span>Remove Captcha</span> -->
                        Remove Captcha
                    </we-button>
                </we-row>

            </div>
        </xpath>
    </template>

    <!-- Captcha Field Specific Options - Shows when user selects captcha field -->
    <template id="website_form_captcha_field_options" inherit_id="website.snippet_options">
        <xpath expr="//div[contains(@data-js, 'Field')]" position="after">
            <div data-js="WebsiteFormCaptchaField"
                data-selector=".s_website_form_captcha">

                <!-- Field Info -->
                <!-- <we-row string="Field Type">
                    <we-button class="o_we_no_toggle o_we_bg_info text-white"
                        style="pointer-events: none;">
                        <i class="fa fa-shield"></i>
                        <span>Captcha Verification</span>
                    </we-button>
                </we-row> -->

                <!-- Captcha Type Selection -->
                <we-select string="Captcha Type"
                    data-no-preview="true"
                    data-attribute-name="captcha_type"
                    data-method="onCaptchaTypeChange">
                    <we-button data-select-data-attribute="mathematical">Mathematical</we-button>
                    <we-button data-select-data-attribute="numeric_image">Numeric Image</we-button>
                    <we-button data-select-data-attribute="alphabetic_image">Alphabetic Image</we-button>
                </we-select>

                <!-- Settings Button - Opens wizard with current type config -->
                <!-- <we-row string="Configuration">
                    <we-button data-settings-captcha="true"
                        class="o_we_no_toggle o_we_bg_primary"
                        data-no-preview="true"
                        title="Configure captcha parameters"
                        data-method="openCaptchaSettings">
                        <i class="fa fa-sliders"></i>
                        <span>Settings</span>
                    </we-button>
                </we-row> -->

            </div>
        </xpath>
    </template>
    
</odoo>