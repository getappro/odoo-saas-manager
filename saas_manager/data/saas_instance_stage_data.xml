<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="saas_instance_stage_draft" model="saas.instance.stage">
        <field name="name">Brouillon</field>
        <field name="sequence">1</field>
        <field name="state">draft</field>
        <field name="color">2</field>
    </record>
    <record id="saas_instance_stage_provisioning" model="saas.instance.stage">
        <field name="name">Provisioning</field>
        <field name="sequence">2</field>
        <field name="state">provisioning</field>
        <field name="color">3</field>
    </record>
    <record id="saas_instance_stage_active" model="saas.instance.stage">
        <field name="name">Active</field>
        <field name="sequence">3</field>
        <field name="state">active</field>
        <field name="color">10</field>
    </record>
    <record id="saas_instance_stage_suspended" model="saas.instance.stage">
        <field name="name">Suspendue</field>
        <field name="sequence">4</field>
        <field name="state">suspended</field>
        <field name="color">4</field>
        <field name="fold">True</field>
    </record>
    <record id="saas_instance_stage_expired" model="saas.instance.stage">
        <field name="name">Expirée</field>
        <field name="sequence">5</field>
        <field name="state">expired</field>
        <field name="color">1</field>
        <field name="fold">True</field>
    </record>
    <record id="saas_instance_stage_terminated" model="saas.instance.stage">
        <field name="name">Terminée</field>
        <field name="sequence">6</field>
        <field name="state">terminated</field>
        <field name="color">0</field>
        <field name="fold">True</field>
    </record>
</odoo>

